{
  "name": "@neram/web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "node scripts/check-docs-drift.mjs && next build && node scripts/check-deployment-assets.mjs",
    "check:deployment-assets": "node scripts/check-deployment-assets.mjs",
    "check:docs": "node scripts/check-docs-drift.mjs",
    "dev": "next dev",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "lint": "eslint .",
    "preview": "next start",
    "test": "vitest run",
    "test:e2e": "bun run build && playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.5.12",
    "@clerk/ui": "^1.20.0",
    "@neram/convex": "workspace:*",
    "@types/mdx": "^2.0.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.41.0",
    "convex-helpers": "^0.1.119",
    "date-fns": "^4.4.0",
    "fumadocs-core": "^16.15.0",
    "fumadocs-mdx": "^15.3.1",
    "fumadocs-ui": "^16.15.0",
    "lucide-react": "^1.21.0",
    "neram": "workspace:*",
    "next": "16.3.1",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.0",
    "react": "^19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.6",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@next/eslint-plugin-next": "16.3.1",
    "@next/playwright": "16.3.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "shadcn": "^4.11.0",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vitest": "^4.1.9"
  }
