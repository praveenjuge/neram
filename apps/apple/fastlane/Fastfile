# Releases for the Apple app. Signing is automatic, using an App Store Connect
# API key (Admin role, so Xcode can manage the distribution certificate):
#
#   ASC_KEY_ID      the key's ID
#   ASC_ISSUER_ID   the team's issuer ID (App Store Connect → Users and Access →
#                   Integrations → App Store Connect API)
#   ASC_KEY_PATH    path to the AuthKey_<id>.p8 file
#
# Run with `bun run beta` from apps/apple, or the "Apple Release" workflow.

default_platform(:ios)

platform :ios do
  desc "Build the iOS app and upload it to TestFlight for internal testers"
  lane :beta do
    key_id = ENV.fetch("ASC_KEY_ID")
    issuer_id = ENV.fetch("ASC_ISSUER_ID")
    key_path = File.expand_path(ENV.fetch("ASC_KEY_PATH"))
    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path
    )

    # One above the newest build of any version, including the Expo builds
    # already on this app record.
    build_number = latest_testflight_build_number(
      api_key: api_key,
      initial_build_number: 0
    ) + 1

    # Lets xcodebuild create or refresh signing assets with the API key.
    signing = "-allowProvisioningUpdates -authenticationKeyPath #{key_path} " \
      "-authenticationKeyID #{key_id} -authenticationKeyIssuerID #{issuer_id}"

    build_app(
      project: "Neram.xcodeproj",
      scheme: "Neram",
      configuration: "Release",
      destination: "generic/platform=iOS",
      export_method: "app-store",
      output_directory: "build",
      # gym passes xcargs to both the archive and the export step.
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number} " \
        "-onlyUsePackageVersionsFromResolvedFile #{signing}"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
